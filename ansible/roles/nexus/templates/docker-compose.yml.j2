version: '3.8'

services:
  nexus:
    image: {{ nexus_image | default('sonatype/nexus3:latest') }}
    container_name: nexus
    restart: always
    ports:
      - "{{ nexus_web_port | default('8081') }}:8081"
      - "{{ nexus_registry_port | default('8082') }}:8082"
    volumes:
      - {{ nexus_data_dir | default('/opt/nexus-data') }}:/nexus-data
