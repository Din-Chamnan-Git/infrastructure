version: '3.8'

services:
  jenkins:
    image: {{ jenkins_image | default('jenkins/jenkins:lts-jdk17') }}
    container_name: jenkins
    restart: always
    user: root
    ports:
      - "{{ jenkins_web_port | default('8080') }}:8080"
      - "{{ jenkins_agent_port | default('50000') }}:50000"
    environment:
      - JAVA_OPTS=-Djenkins.install.runSetupWizard=true
    volumes:
      - {{ jenkins_home_dir | default('/opt/jenkins_home') }}:/var/jenkins_home
      - /var/run/docker.sock:/var/run/docker.sock
