version: '3.8'

services:
  sonarqube-db:
    image: {{ sonarqube_db_image | default('postgres:15-alpine') }}
    container_name: sonarqube-db
    restart: always
    environment:
      - POSTGRES_USER={{ sonarqube_db_user | default('sonar') }}
      - POSTGRES_PASSWORD={{ sonarqube_db_password | default('sonar_secret_pass') }}
      - POSTGRES_DB={{ sonarqube_db_name | default('sonar') }}
    volumes:
      - {{ sonarqube_db_dir | default('/opt/sonarqube/postgresql') }}:/var/lib/postgresql/data
    networks:
      - sonar-net

  sonarqube:
    image: {{ sonarqube_image | default('sonarqube:lts-community') }}
    container_name: sonarqube
    restart: always
    depends_on:
      - sonarqube-db
    ports:
      - "{{ sonarqube_web_port | default('9000') }}:9000"
    environment:
      - SONAR_JDBC_USERNAME={{ sonarqube_db_user | default('sonar') }}
      - SONAR_JDBC_PASSWORD={{ sonarqube_db_password | default('sonar_secret_pass') }}
      - SONAR_JDBC_URL=jdbc:postgresql://sonarqube-db:5432/{{ sonarqube_db_name | default('sonar') }}
    volumes:
      - {{ sonarqube_data_dir | default('/opt/sonarqube/data') }}:/opt/sonarqube/data
      - {{ sonarqube_extensions_dir | default('/opt/sonarqube/extensions') }}:/opt/sonarqube/extensions
      - {{ sonarqube_logs_dir | default('/opt/sonarqube/logs') }}:/opt/sonarqube/logs
    networks:
      - sonar-net

networks:
  sonar-net:
    driver: bridge
